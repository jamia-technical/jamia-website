generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model admissions {
  id                Int            @id @default(autoincrement())
  name              String
  whatsapp          String
  stream            String
  dob               String?
  email             String?   
  father_name       String?
  place             String?
  district          String?
  state             String?
  level             String?
  photo             String?
  imgid             String?
  islamic_education String?
  islamic_details   String?
  school_name       String?
  last_exam_mark    String?
  address           String?
  achievements      String?
  skills            String?
  interview_done      Boolean?           @default(false)
  fee_done            Boolean?           @default(false)
  created_at          DateTime?          @default(now()) @db.Timestamptz(6)
  exam_results        exam_results?
  panel_assignment    panel_assignment?
}

model exam_results {
  id                  Int        @id @default(autoincrement())
  admission_id        Int        @unique
  admission           admissions @relation(fields: [admission_id], references: [id], onDelete: Cascade)
  islamic_knowledge   Int?       // max 20
  science_aptness     Int?       // max 15
  communication       Int?       // max 15
  general_awareness   Int?       // max 15
  achievements        Int?       // max 15
  leadership          Int?       // max 10
  interpersonal       Int?       // max 10
  written_test        Int?       // max 100
  created_at          DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?  @default(now()) @db.Timestamptz(6)
}

model auth {
  id       Int    @id @default(autoincrement())
  username String @unique(map: "auth_username_unique")
  password String
}

model contacts {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(150)
  email      String    @db.VarChar(150)
  phone      String?   @db.VarChar(20)
  subject    String    @db.VarChar(50)
  message    String
  status     String?   @default("unread") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "idx_contacts_created_at")
  @@index([email], map: "idx_contacts_email")
  @@index([status], map: "idx_contacts_status")
}

model images {
  id        Int       @id @default(autoincrement())
  image     String    @db.VarChar(255)
  imgid     String    @unique @db.VarChar(100)
  timestamp DateTime? @default(now()) @db.Timestamp(6)
}

model news {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  content     String?
  image       String?
  imgid       String?
  ispublished Boolean?  @default(false)
  createdat   DateTime? @default(now()) @db.Timestamp(6)
  publishedat DateTime? @db.Timestamp(6)
  category    String?   @default("Events") @db.VarChar(100)
  slug        String    @unique @default(dbgenerated("SUBSTRING((gen_random_uuid())::text FROM 1 FOR 12)")) @db.VarChar(255)
}

model publication {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?
  issue       String?   @db.VarChar(100)
  coverimage  String?
  coverimgid  String?
  pdfurl      String?
  pdfid       String?   @db.VarChar(255)
  ispublished Boolean?  @default(false)
  createdat   DateTime? @default(now()) @db.Timestamp(6)
  publishedat DateTime? @db.Timestamp(6)
  slug        String    @unique @default(dbgenerated("SUBSTRING((gen_random_uuid())::text FROM 1 FOR 12)")) @db.VarChar(255)
}

model panel {
  id           Int                @id @default(autoincrement())
  name         String
  level        String
  stream       String?
  created_at   DateTime?          @default(now()) @db.Timestamptz(6)
  assignments  panel_assignment[]
}

model panel_assignment {
  id            Int        @id @default(autoincrement())
  panel_id      Int
  admission_id  Int        @unique
  assigned_at   DateTime?  @default(now()) @db.Timestamptz(6)
  panel         panel      @relation(fields: [panel_id], references: [id], onDelete: Cascade)
  admission     admissions @relation(fields: [admission_id], references: [id], onDelete: Cascade)
}
